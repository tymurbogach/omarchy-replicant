#!/bin/bash
# omarchy-replicant — savegame para Omarchy 4 (port de omarchy_thinkpad)
# Siempre privado, todo (config+secrets+state), MANIFEST fijo
# Panel anclado debajo del icono usa este CLI vía status --json
set -euo pipefail

REAL_BIN="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(cd -- "$(dirname -- "$REAL_BIN")/.." && pwd)"
CORE="$PLUGIN_DIR/bin/replicant-core.sh"
# fallback if running via copy without plugin dir
if [[ ! -f "$CORE" ]]; then
  for p in "$HOME/.config/omarchy/plugins/io.github.tymurbogach.omarchy-replicant/bin/replicant-core.sh" "/usr/share/omarchy/bin/replicant-core.sh"; do
    [[ -f "$p" ]] && CORE="$p" && PLUGIN_DIR="$(cd -- "$(dirname -- "$p")/.." && pwd)" && break
  done
fi
REPLICANT_HOME="${OMARCHY_REPLICANT_HOME:-$HOME/.local/share/omarchy-replicant}"
REPO_DIR="$REPLICANT_HOME/repo"
DEFAULT_REPO_NAME="omarchy-replicant"

fail() { echo "omarchy-replicant: $*" >&2; exit 1; }
info() { echo -e "\e[36m$*\e[0m" >&2; }
warn() { echo -e "\e[33m$*\e[0m" >&2; }
ok()   { echo -e "\e[32m$*\e[0m" >&2; }

git_repo() { git -C "$REPO_DIR" "$@"; }

ensure_core() { [[ -x "$CORE" ]] || fail "replicant-core.sh no encontrado en $CORE"; }

cmd_status() { ensure_core; bash "$CORE" status "${1:-}"; }
cmd_backup() { ensure_core; bash "$CORE" backup; }

cmd_init() {
  local savegame=0
  while (( $# )); do case "$1" in --savegame) savegame=1; shift;; *) shift;; esac; done
  ensure_core
  # always savegame layout
  bash "$CORE" backup
  git_repo add -A
  if git_repo diff --cached --quiet; then ok "init: nada nuevo"; else git_repo commit -q -m "replicant: init $(date +%F) $(hostname)"; ok "init commit"; fi
  git_repo config core.hooksPath .githooks 2>/dev/null || true
  ok "init listo en $REPO_DIR (savegame layout: config/secrets/state)"
}

cmd_login() {
  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then ok "ya logueado: $(gh auth status 2>&1 | head -n1)"; return 0; fi
    info "gh auth login..."; gh auth login --web --git-protocol https || gh auth login
  else fail "gh no instalado: omarchy pkg add github-cli"; fi
}

cmd_create() {
  local name="$DEFAULT_REPO_NAME" do_push=0
  while (( $# )); do case "$1" in
    --private) shift;; # always private, ignore
    --public) warn "replicante es siempre privado (contiene secrets/) — ignorando --public"; shift;;
    --push) do_push=1; shift;;
    --help|-h) echo "Usage: omarchy-replicant create [name] [--push] (siempre --private)"; return 0;;
    -*) fail "opción desconocida: $1";;
    *) name="$1"; shift;;
  esac; done
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || fail "nombre inválido: $name"
  cmd_login
  ensure_core
  if [[ ! -d "$REPO_DIR/.git" ]]; then cmd_init; else bash "$CORE" backup; fi
  local gh_user
  gh_user=$(gh api user --jq .login 2>/dev/null || gh auth status 2>&1 | grep -oP 'account \K\w+' | head -n1)
  [[ -n "$gh_user" ]] || fail "no gh user"
  info "creando github.com/$gh_user/$name --private ..."
  if gh repo view "$gh_user/$name" >/dev/null 2>&1; then
    local vis
    vis=$(gh repo view "$gh_user/$name" --json visibility --jq .visibility 2>/dev/null || echo "")
    if [[ "$vis" == "PUBLIC" ]]; then
      warn "repo ya existe como PÚBLICO — pásalo a privado: gh repo edit $gh_user/$name --visibility private"
    else warn "repo ya existe — enlazando remote"; fi
  else
    gh repo create "$name" --private --description "Omarchy replicant — savegame privado (config+secrets+state)" 2>&1 || fail "gh create falló"
  fi
  local url="https://github.com/$gh_user/$name.git"
  if git_repo remote get-url origin >/dev/null 2>&1; then git_repo remote set-url origin "$url"; else git_repo remote add origin "$url"; fi
  git_repo branch -M main 2>/dev/null || true
  git_repo add -A
  if ! git_repo diff --cached --quiet; then git_repo commit -m "replicant: create $name $(date -Is)" || true; fi
  if (( do_push )) || { command -v gum >/dev/null 2>&1 && gum confirm "¿Push ahora a $url?"; }; then
    git_repo push -u origin main 2>&1 || git_repo push -u origin HEAD 2>&1
    ok "push listo a $url (privado)"
  else info "remote $url — ejecuta omarchy-replicant savegame para subir"; fi
}

# savegame — sistema -> repo -> GitHub (port de savegame.sh)
cmd_savegame() {
  local MSG="" PUSH=1
  while (( $# )); do case "$1" in
    -m|--message) MSG=${2:-}; [[ -n "$MSG" ]] || fail "-m necesita mensaje"; shift 2;;
    --no-push) PUSH=0; shift;;
    -h|--help) echo "savegame: backup + commit state auto + push. Sin -m deja config/secrets sin commitear para 1 commit por cambio."; return 0;;
    *) fail "opción desconocida: $1";;
  esac; done
  ensure_core
  if [[ $(git -C "$REPO_DIR" config core.hooksPath 2>/dev/null) != ".githooks" ]]; then
    echo "→ Activando .githooks" >&2
    git -C "$REPO_DIR" config core.hooksPath .githooks 2>/dev/null || true
  fi
  echo "→ savegame: copiando al repo" >&2
  bash "$CORE" backup

  if [[ -z $(git_repo status --porcelain 2>/dev/null) ]]; then
    echo "Sin cambios. Nada que guardar." >&2; return 0; fi

  if [[ -n $(git_repo status --porcelain -- state/ 2>/dev/null) ]]; then
    git_repo add -A state/
    git_repo commit -q -m "state: inventario $(date +%F)"
    echo "→ Commit inventario:" >&2; git_repo show --stat --oneline HEAD 2>/dev/null | sed 's/^/    /' >&2; echo >&2
  fi

  local pendientes
  pendientes=$(git_repo status --porcelain -- . ':(exclude)state/' 2>/dev/null || true)
  if [[ -n $pendientes && -n $MSG ]]; then
    git_repo add -A
    git_repo commit -q -m "$MSG"
    echo "→ Commit único (-m):" >&2; git_repo show --stat --oneline HEAD 2>/dev/null | sed 's/^/    /' >&2; echo >&2
    pendientes=""
  fi

  if (( PUSH )) && [[ -n $(git_repo log --oneline @{u}..HEAD 2>/dev/null) ]]; then
    echo "→ Push a $(git_repo config --get remote.origin.url 2>/dev/null)" >&2
    git_repo push -q origin HEAD 2>&1 && echo "    hecho" >&2; echo >&2
  fi

  if [[ -n $pendientes ]]; then
    echo "── Cambios SIN commitear ──" >&2
    echo "Un commit por cambio, explicando PORQUÉ (omarchy_thinkpad Reglas 2 y 3)." >&2; echo >&2
    while read -r estado ruta; do printf '  %s  %s\n' "$estado" "$ruta" >&2; done <<<"$pendientes"; echo >&2
    for ruta in $(git_repo diff --name-only -- . ':(exclude)state/' ':(exclude)secrets/' 2>/dev/null); do
      echo "── $ruta ──" >&2; git_repo diff --unified=1 -- "$ruta" 2>/dev/null | sed -n '5,120p' | sed 's/^/    /' >&2; echo >&2
    done
    if git_repo status --porcelain -- secrets/ 2>/dev/null | grep -q .; then
      echo "── secrets/ ──" >&2; echo "    cambiaron (contenido no mostrado):" >&2
      git_repo status --porcelain -- secrets/ 2>/dev/null | sed 's/^/    /' >&2; echo >&2
    fi
    echo "Cuando estén commiteados: git -C $REPO_DIR push origin HEAD" >&2
  else echo "Todo guardado y subido." >&2; fi
}

cmd_diff() { ensure_core; git_repo status --short 2>/dev/null | head -n 100; echo "--- diff --cached ---" >&2; git_repo diff --cached --stat 2>/dev/null | head -n 100; }

cmd_pull() {
  [[ -d "$REPO_DIR/.git" ]] || fail "sin repo — clone primero"
  git_repo fetch --all --prune 2>&1
  local dirty; dirty=$(git_repo status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  if (( dirty > 0 )); then warn "$dirty dirty — stash"; git_repo stash push -m "replicant auto-stash $(date -Is)" 2>/dev/null || true; fi
  local br; br=$(git_repo rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)
  git_repo pull --rebase origin "$br" 2>&1 || git_repo pull --rebase 2>&1 || warn "conflictos — revisa $REPO_DIR"
  ok "pull OK"
}

cmd_clone() {
  local url="${1:-}"; [[ -n "$url" ]] || { if [[ -t 0 ]]; then url=$(gum input --prompt "Git URL (privado): " 2>/dev/null || true); fi; [[ -n "$url" ]] || fail "uso: clone <git-url>"; }
  command -v omarchy-git-url-check >/dev/null 2>&1 && omarchy-git-url-check "$url" || true
  [[ -d "$REPO_DIR/.git" ]] && fail "$REPO_DIR ya existe — pull o borra"
  mkdir -p "$(dirname "$REPO_DIR")"
  git clone -- "$url" "$REPO_DIR" 2>&1 || fail "clone falló (¿privado sin gh auth?)"
  git -C "$REPO_DIR" config core.hooksPath .githooks 2>/dev/null || true
  ok "clonado en $REPO_DIR — ejecuta omarchy-replicant restore --dry-run"
}

# restore — port bootstrap+restore-desktop por grupos, con .bak.<epoch> (lib.sh:poner)
cmd_restore() {
  local DRY=1 TODOS=0
  while (( $# )); do case "$1" in --apply) DRY=0; shift;; --all) TODOS=1; shift;; --dry-run) DRY=1; shift;; *) shift;; esac; done
  [[ -d "$REPO_DIR/.git" ]] || fail "sin repo"
  # shellcheck source=/dev/null
  source "$PLUGIN_DIR/bin/replicant-core.sh" 2>/dev/null || true
  # define grupos como restore-desktop.sh
  local GRUPOS=(
    "ssh:SSH (config + claves) — ~/.ssh"
    "git:Git config y PAT keyring"
    "env:Secrets env — ~/.config/environment.d"
    "shell:bashrc/XCompose"
    "claude:Claude Code hooks y mcp"
    "hypr:Hyprland Lua — input/monitors/autostart"
    "shell_omarchy:Omarchy shell.json + hooks/audit"
    "uwsm:uwsm env.d + xdg-terminals"
    "terminal:alacritty/foot"
    "branding:Omarchy branding screensaver"
  )
  # mapping replicant repo layout -> destino
  ficheros_de() {
    case $1 in
      ssh) echo "secrets/ssh/id_ed25519|$HOME/.ssh/id_ed25519|600"; echo "secrets/ssh/id_ed25519.pub|$HOME/.ssh/id_ed25519.pub|644"; echo "config/ssh/config|$HOME/.ssh/config|600" ;;
      git) echo "config/git/config|$HOME/.config/git/config|644" ;;
      env) echo "secrets/env/60-secrets.conf|$HOME/.config/environment.d/60-secrets.conf|600" ;;
      shell) echo "config/home/bashrc|$HOME/.bashrc|644"; echo "config/home/XCompose|$HOME/.XCompose|644" ;;
      claude) echo "config/claude/settings.json|$HOME/.claude/settings.json|644"; echo "config/claude/settings.local.json|$HOME/.claude/settings.local.json|644"; echo "config/claude/mcp.json|$HOME/.claude/.mcp.json|644"; for h in cbm-code-discovery-gate cbm-session-reminder cbm-subagent-reminder; do echo "config/claude/hooks/$h|$HOME/.claude/hooks/$h|755"; done ;;
      hypr) for f in "$REPO_DIR/config/hypr/"*.lua; do [[ -f $f ]] || continue; echo "$f|$HOME/.config/hypr/$(basename "$f")|644"; done ;;
      shell_omarchy) echo "config/omarchy/shell.json|$HOME/.config/omarchy/shell.json|644"; echo "config/omarchy/hooks/post-update.d/audit-config.hook|$HOME/.config/omarchy/hooks/post-update.d/audit-config.hook|644"; echo "config/omarchy-audit-ignore|$HOME/.config/omarchy-audit-ignore|644"; echo "config/bin/omarchy-audit|$HOME/.local/bin/omarchy-audit|755" ;;
      uwsm) for f in "$REPO_DIR"/config/uwsm/env.d/*; do [[ -f $f ]] || continue; echo "$f|$HOME/.config/uwsm/env.d/$(basename "$f")|644"; done; echo "config/xdg-terminals.list|$HOME/.config/xdg-terminals.list|644" ;;
      terminal) echo "config/alacritty/alacritty.toml|$HOME/.config/alacritty/alacritty.toml|644"; echo "config/foot/foot.ini|$HOME/.config/foot/foot.ini|644" ;;
      branding) echo "config/branding/screensaver.txt|$HOME/.config/omarchy/branding/screensaver.txt|644" ;;
    esac
  }
  export DRY
  for grupo in "${GRUPOS[@]}"; do
    nombre=${grupo%%:*}; echo; echo "== $nombre · ${grupo#*:}" >&2
    pendientes=()
    while IFS='|' read -r src dst modo; do [[ -f $src ]] || continue; if [[ -f $dst ]] && cmp -s "$src" "$dst" 2>/dev/null; then ok "${dst/#$HOME/\~} (ya igual)" >&2; else pendientes+=("$src|$dst|$modo"); fi; done < <(ficheros_de "$nombre")
    if (( ${#pendientes[@]} == 0 )); then skip "nada que cambiar" >&2; continue; fi
    for e in "${pendientes[@]}"; do IFS='|' read -r src dst modo <<<"$e"; echo "  ── ${dst/#$HOME/\~}" >&2; if [[ -f $dst ]]; then diff -u --label sistema --label repo "$dst" "$src" 2>/dev/null | sed -n '3,40p' | sed 's/^/      /' >&2 || true; else echo "      (no existe: se crearía)" >&2; fi; done
    if (( DRY )); then skip "dry-run: ${#pendientes[@]} fichero(s) sin tocar. Repite con --apply" >&2; continue; fi
    if (( ! TODOS )); then read -rp "  ¿aplicar $nombre? [y/N] " resp </dev/tty 2>&1 || resp=""; [[ $resp == [yY] ]] || { skip "$nombre omitido" >&2; continue; }; fi
    for e in "${pendientes[@]}"; do IFS='|' read -r src dst modo <<<"$e"; poner "$src" "$dst" "$modo" 2>&1; done
  done
  echo; if (( DRY )); then echo "Dry-run — para escribir: omarchy-replicant restore --apply" >&2; else ok "restore grupos completado — revisa .bak.<epoch>" >&2; fi
}

usage() {
  cat <<USAGE
omarchy-replicant — savegame privado (config+secrets+state) para Omarchy

Uso:
  omarchy-replicant init [--savegame]     Prepara repo savegame (siempre privado)
  omarchy-replicant login                 gh auth
  omarchy-replicant create [name] [--push]  Crea repo PRIVADO y push
  omarchy-replicant backup                Solo copia (sin git)
  omarchy-replicant savegame [-m "porqué"] [--no-push]  backup + commit state auto + push (deja config/secrets para 1 commit por cambio)
  omarchy-replicant status [--json]
  omarchy-replicant diff
  omarchy-replicant push [-m msg] [-y]    Push directo (no savegame)
  omarchy-replicant pull
  omarchy-replicant clone <url>           Clona repo privado
  omarchy-replicant restore [--dry-run|--apply] [--all]  Por grupos con .bak.<epoch>

Flujo:
  omarchy-replicant init && omarchy-replicant create --push   # primera máquina (privado)
  omarchy-replicant savegame                   # día a día
  # nueva máquina:
  omarchy-replicant clone https://github.com/<user>/omarchy-replicant
  omarchy-replicant restore --apply
USAGE
}

main() {
  local cmd="${1:-}"; [[ -z "$cmd" ]] && { usage; exit 0; }
  case "$cmd" in
    -h|--help|help) usage; exit 0;;
    init) shift; cmd_init "$@";;
    login) shift; cmd_login "$@";;
    create) shift; cmd_create "$@";;
    backup) shift; cmd_backup "$@";;
    savegame) shift; cmd_savegame "$@";;
    status) shift; cmd_status "$@";;
    diff) shift; cmd_diff "$@";;
    push) shift;
      # push legacy wrapper for simple repo: still works but delegate to savegame-style push
      ensure_core; bash "$CORE" backup 2>&1 | tail -n 5
      git_repo add -A 2>/dev/null || true
      if git_repo diff --cached --quiet 2>/dev/null; then ok "nada que pushear"; exit 0; fi
      local msg="replicant: sync $(date -Is)"; [[ $# -gt 0 ]] && msg="$*"
      git_repo commit -m "$msg" 2>&1 | tail -n 5
      git_repo push -u origin "$(git_repo rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)" 2>&1 | tail -n 10
      ;;
    pull) shift; cmd_pull "$@";;
    clone) shift; cmd_clone "$@";;
    restore) shift; cmd_restore "$@";;
    *) fail "comando $cmd desconocido — --help";;
  esac
}
main "$@"
