#!/bin/bash
# omarchy-replicant — savegame for Omarchy 4 (ported from omarchy_thinkpad)
# Always private, everything (config+secrets+state), fixed MANIFEST
# The panel anchored under the bar icon drives this CLI via status --json
set -euo pipefail

REAL_BIN="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(cd -- "$(dirname -- "$REAL_BIN")/.." && pwd)"
CORE="$PLUGIN_DIR/bin/replicant-core.sh"
# fallback if running via a copy without the plugin dir
if [[ ! -f "$CORE" ]]; then
  for p in "$HOME/.config/omarchy/plugins/io.github.tymurbogach.omarchy-replicant/bin/replicant-core.sh" "/usr/share/omarchy/bin/replicant-core.sh"; do
    [[ -f "$p" ]] && CORE="$p" && PLUGIN_DIR="$(cd -- "$(dirname -- "$p")/.." && pwd)" && break
  done
fi
PLUGIN_ID="io.github.tymurbogach.omarchy-replicant"
REPLICANT_HOME="${OMARCHY_REPLICANT_HOME:-$HOME/.local/share/omarchy-replicant}"
REPO_DIR="$REPLICANT_HOME/repo"
# Default name for `create`: <this machine's hostname>-replicant, so each user/machine
# gets its own distinctly-named private repo instead of everyone colliding on the same
# literal name — which would also collide with the plugin's own repo name,
# "omarchy-replicant", on any machine whose hostname happens to be "omarchy" (the
# distro's own default hostname — not a hypothetical, this actually happened). If that
# exact collision would occur, fall back to $USER instead.
_replicant_hostname="$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo host)"
if [[ "$_replicant_hostname-replicant" == "omarchy-replicant" ]]; then
  DEFAULT_REPO_NAME="${USER:-user}-replicant"
else
  DEFAULT_REPO_NAME="$_replicant_hostname-replicant"
fi

fail() { echo "omarchy-replicant: $*" >&2; exit 1; }
info() { echo -e "\e[36m$*\e[0m" >&2; }
warn() { echo -e "\e[33m$*\e[0m" >&2; }
ok()   { echo -e "\e[32m$*\e[0m" >&2; }

git_repo() { git -C "$REPO_DIR" "$@"; }

# Serialize everything that writes to the repo. Without this, two commands
# racing (the panel firing `set` twice while a savegame is still committing)
# collide on .git/index.lock and one of them dies half-done. Commands queue
# instead of failing; 90s is far longer than any real operation here.
acquire_repo_lock() {
  mkdir -p "$REPLICANT_HOME"
  exec 9>"$REPLICANT_HOME/.replicant.lock" || return 0
  if ! flock -w 90 9; then
    fail "another omarchy-replicant operation is still running — try again in a moment"
  fi
}

ensure_core() { [[ -x "$CORE" ]] || fail "replicant-core.sh not found at $CORE"; }

cmd_status() { ensure_core; bash "$CORE" status "$@"; }
cmd_backup() { ensure_core; bash "$CORE" backup; }

cmd_init() {
  local savegame=0
  while (( $# )); do case "$1" in --savegame) savegame=1; shift;; *) shift;; esac; done
  ensure_core
  # always savegame layout
  bash "$CORE" backup
  git_repo add -A
  if git_repo diff --cached --quiet; then ok "init: nothing new"; else git_repo commit -q -m "replicant: init $(date +%F) $(hostname)"; ok "init commit"; fi
  git_repo config core.hooksPath .githooks 2>/dev/null || true
  ok "init done at $REPO_DIR (savegame layout: config/secrets/state)"
}

cmd_login() {
  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then ok "already logged in: $(gh auth status 2>&1 | head -n1)"; return 0; fi
    info "gh auth login..."; gh auth login --web --git-protocol https || gh auth login
  else fail "gh not installed: omarchy pkg add github-cli"; fi
}

cmd_create() {
  local name="$DEFAULT_REPO_NAME" do_push=0
  while (( $# )); do case "$1" in
    --private) shift;; # always private, ignore
    --public) warn "replicant is always private (it holds secrets/) — ignoring --public"; shift;;
    --push) do_push=1; shift;;
    --help|-h) echo "Usage: omarchy-replicant create [name] [--push] (always --private)"; return 0;;
    -*) fail "unknown option: $1";;
    *) name="$1"; shift;;
  esac; done
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || fail "invalid name: $name"
  cmd_login
  ensure_core
  if [[ ! -d "$REPO_DIR/.git" ]]; then cmd_init; else bash "$CORE" backup; fi
  local gh_user
  gh_user=$(gh api user --jq .login 2>/dev/null || gh auth status 2>&1 | grep -oP 'account \K\w+' | head -n1)
  [[ -n "$gh_user" ]] || fail "no gh user"
  info "creating github.com/$gh_user/$name --private ..."
  if gh repo view "$gh_user/$name" >/dev/null 2>&1; then
    local vis
    vis=$(gh repo view "$gh_user/$name" --json visibility --jq .visibility 2>/dev/null || echo "")
    if [[ "$vis" == "PUBLIC" ]]; then
      warn "repo already exists and is PUBLIC — switch it to private: gh repo edit $gh_user/$name --visibility private"
    else warn "repo already exists — linking remote"; fi
  else
    gh repo create "$name" --private --description "Omarchy replicant — private savegame (config+secrets+state)" 2>&1 || fail "gh create failed"
  fi
  local url="https://github.com/$gh_user/$name.git"
  local current_url; current_url=$(git_repo remote get-url origin 2>/dev/null || echo "")
  if [[ -n "$current_url" && "$current_url" != "$url" ]]; then
    warn "$REPO_DIR is already pointed at $current_url"
    read -rp "Re-point it to $url instead? This does NOT touch what's already pushed there, but future savegame/push go to the new remote [y/N] " resp </dev/tty 2>&1 || resp=""
    [[ $resp == [yY] ]] || fail "create cancelled — remote left pointing at $current_url"
    git_repo remote set-url origin "$url"
  elif [[ -z "$current_url" ]]; then
    git_repo remote add origin "$url"
  fi
  git_repo branch -M main 2>/dev/null || true
  git_repo add -A
  if ! git_repo diff --cached --quiet; then git_repo commit -m "replicant: create $name $(date -Is)" || true; fi
  if (( do_push )) || { command -v gum >/dev/null 2>&1 && gum confirm "Push now to $url?"; }; then
    git_repo push -u origin main 2>&1 || git_repo push -u origin HEAD 2>&1
    ok "pushed to $url (private)"
  else info "remote $url — run omarchy-replicant savegame to push"; fi
}

# savegame — system -> repo -> GitHub (ported from savegame.sh)
cmd_savegame() {
  local MSG="" PUSH=1
  while (( $# )); do case "$1" in
    -m|--message) MSG=${2:-}; [[ -n "$MSG" ]] || fail "-m needs a message"; shift 2;;
    --no-push) PUSH=0; shift;;
    -h|--help) echo "savegame: backup + auto-commit state + push. Without -m, leaves config/secrets uncommitted for 1 commit per change."; return 0;;
    *) fail "unknown option: $1";;
  esac; done
  ensure_core
  if [[ $(git -C "$REPO_DIR" config core.hooksPath 2>/dev/null) != ".githooks" ]]; then
    echo "→ Enabling .githooks" >&2
    git -C "$REPO_DIR" config core.hooksPath .githooks 2>/dev/null || true
  fi
  echo "→ savegame: copying into the repo" >&2
  bash "$CORE" backup

  if [[ -z $(git_repo status --porcelain 2>/dev/null) ]]; then
    echo "No changes. Nothing to save." >&2; return 0; fi

  if [[ -n $(git_repo status --porcelain -- state/ 2>/dev/null) ]]; then
    git_repo add -A state/
    git_repo commit -q -m "state: inventory $(date +%F)"
    echo "→ Inventory commit:" >&2; git_repo show --stat --oneline HEAD 2>/dev/null | sed 's/^/    /' >&2; echo >&2
  fi

  local pending
  pending=$(git_repo status --porcelain -- . ':(exclude)state/' 2>/dev/null || true)
  if [[ -n $pending && -n $MSG ]]; then
    git_repo add -A
    git_repo commit -q -m "$MSG"
    echo "→ Single commit (-m):" >&2; git_repo show --stat --oneline HEAD 2>/dev/null | sed 's/^/    /' >&2; echo >&2
    pending=""
  fi

  if (( PUSH )) && [[ -n $(git_repo log --oneline @{u}..HEAD 2>/dev/null) ]]; then
    echo "→ Push to $(git_repo config --get remote.origin.url 2>/dev/null)" >&2
    git_repo push -q origin HEAD 2>&1 && echo "    done" >&2; echo >&2
  fi

  if [[ -n $pending ]]; then
    echo "── Uncommitted changes ──" >&2
    echo "One commit per change, explaining WHY (omarchy_thinkpad Rules 2 and 3)." >&2; echo >&2
    while read -r state path; do printf '  %s  %s\n' "$state" "$path" >&2; done <<<"$pending"; echo >&2
    for path in $(git_repo diff --name-only -- . ':(exclude)state/' ':(exclude)secrets/' 2>/dev/null); do
      echo "── $path ──" >&2; git_repo diff --unified=1 -- "$path" 2>/dev/null | sed -n '5,120p' | sed 's/^/    /' >&2; echo >&2
    done
    if git_repo status --porcelain -- secrets/ 2>/dev/null | grep -q .; then
      echo "── secrets/ ──" >&2; echo "    changed (content not shown):" >&2
      git_repo status --porcelain -- secrets/ 2>/dev/null | sed 's/^/    /' >&2; echo >&2
    fi
    echo "Once committed: git -C $REPO_DIR push origin HEAD" >&2
  else echo "Everything saved and pushed." >&2; fi
}

# `diff` with no id: what is pending in the repo as a whole. With an id it is
# cmd_open_diff instead, which compares one file.
cmd_diff() {
  ensure_core
  # Without this the last git call exits 128 into main() and the user gets an
  # empty header and a failure code, where every other command says "no repo".
  [[ -d "$REPO_DIR/.git" ]] || fail "no repo yet — run 'create' or 'clone' first"
  local pending; pending=$(git_repo status --short 2>/dev/null | head -n 100)
  if [[ -z "$pending" ]]; then
    ok "nothing pending — everything copied in is committed"
  else
    printf '%s\n' "$pending"
  fi
  local staged; staged=$(git_repo diff --cached --stat 2>/dev/null | head -n 100)
  [[ -n "$staged" ]] && { echo "--- staged ---" >&2; printf '%s\n' "$staged"; }
  return 0
}

# edit/diff/reset by config id — used by the panel.
# The id -> real path mapping lives in the core (resolve_manifest_src) so the
# CLI, the panel's diff view and the core all resolve an id identically.
resolve_src() {
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  resolve_manifest_src "$1"
}

cmd_path() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "usage: path <id>"
  resolve_src "$id" || fail "unknown id: $id"
}

# cmd_edit <id> [--wait]
#
# --wait holds until the editor is closed again, so the panel can come back to
# exactly where it was instead of leaving the user to reopen it. Only some
# editors can be waited on; the caller is told which happened rather than left
# to guess, because reopening a panel over a floating terminal editor would be
# worse than not reopening at all.
cmd_edit() {
  local id="" wait_for_editor=0 arg
  for arg in "$@"; do
    case "$arg" in
      --wait) wait_for_editor=1 ;;
      *) [[ -z "$id" ]] && id="$arg" ;;
    esac
  done
  [[ -n "$id" ]] || fail "usage: edit <id> [--wait]  (e.g. hypr/input.lua)"
  local src
  src=$(resolve_src "$id") || fail "unknown id: $id"
  if [[ ! -f "$src" ]]; then
    warn "$src doesn't exist — it will be created on edit"
    mkdir -p "$(dirname "$src")"
    touch "$src"
  fi
  # omarchy-launch-editor and nothing else. Not
  # omarchy-launch-floating-terminal-with-presentation (that wraps the command
  # in the Omarchy logo plus a "press a key to close" prompt — two extra
  # interactions to read one file) and not omarchy-launch-config-editor (which
  # adds a desktop notification per click). Editing a config should be: click,
  # editor. It detaches via setsid, so this returns immediately.
  # GUI editors that hold the command until their tab is closed. A terminal
  # editor is opened in a floating terminal that detaches, so there is nothing
  # to wait on without reimplementing Omarchy's own terminal launching.
  local editor=""
  [[ -f "$HOME/.local/state/omarchy/defaults/editor" ]] && read -r editor < "$HOME/.local/state/omarchy/defaults/editor"
  local can_wait=0
  case "${editor##*/}" in
    code|code-insiders|codium|vscodium|zed) can_wait=1 ;;
  esac

  if (( wait_for_editor && can_wait )) && command -v "$editor" >/dev/null 2>&1; then
    # `setsid --wait` gives the editor its own session, so a shell restart
    # cannot take an open file down with it, while still telling us when it
    # exits. uwsm-app keeps it in the same scope Omarchy would have used.
    if command -v uwsm-app >/dev/null 2>&1; then
      setsid --wait uwsm-app -- "$editor" --wait "$src" >/dev/null 2>&1 || true
    else
      setsid --wait "$editor" --wait "$src" >/dev/null 2>&1 || true
    fi
    # The caller reopens on this and only this. Silence means "not waited".
    echo "replicant:waited"
    return 0
  fi

  if command -v omarchy-launch-editor >/dev/null 2>&1; then
    omarchy-launch-editor "$src"
  else
    xdg-open "$src" 2>/dev/null || "${EDITOR:-nvim}" "$src"
  fi
}

cmd_open_diff() {
  local id="" against="auto" in_terminal=0
  while (( $# )); do case "$1" in
    --against) against="${2:-auto}"; shift 2;;
    --terminal) in_terminal=1; shift;;
    --plain) in_terminal=0; shift;;
    -*) fail "unknown option: $1";;
    *) id="$1"; shift;;
  esac; done
  [[ -n "$id" ]] || fail "usage: diff <id> [--against repo|default] [--terminal]"
  ensure_core
  if (( in_terminal )) && command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1; then
    omarchy-launch-floating-terminal-with-presentation "omarchy-replicant diff '${id//\'/}' --against $against | less -R"
    return 0
  fi
  # plain text on stdout: the panel renders this inline
  bash "$CORE" diff "$id" "$against"
}

cmd_reset() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "usage: reset <id>  (restores the default via omarchy refresh)"
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  local src
  src=$(resolve_manifest_src "$id") || fail "unknown id: $id"
  # `omarchy refresh config` restores one FILE. A tracked directory has no
  # single default to go back to, and today the only reason one is never
  # offered is that Omarchy happens to ship no default for the directories
  # people track — luck, not design.
  is_dir_entry "$id" && fail "$id is a directory — reset restores one file; use restore-file to bring the tree back from your repo"
  # Only a file Omarchy actually ships a default for can be reset, and the
  # refresh path is derived from the real file rather than from the repo
  # layout — the two only coincide by accident (repo "home/bashrc" is
  # ~/.bashrc, not ~/.config/home/bashrc).
  default_for_src "$src" >/dev/null || fail "$id has no Omarchy default — it is entirely yours, nothing to reset to"
  local rel
  rel=$(config_rel_for_src "$src") || fail "$id lives outside ~/.config — reset only handles Omarchy's own config files"
  command -v omarchy >/dev/null 2>&1 || fail "omarchy not found"
  omarchy refresh config "$rel" 2>&1 || fail "omarchy refresh config $rel failed"
  ok "reset $rel → previous version kept as .bak.<epoch>"
}

cmd_pull() {
  [[ -d "$REPO_DIR/.git" ]] || fail "no repo — clone first"
  git_repo fetch --all --prune 2>&1
  local dirty; dirty=$(git_repo status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  if (( dirty > 0 )); then warn "$dirty dirty — stashing"; git_repo stash push -m "replicant auto-stash $(date -Is)" 2>/dev/null || true; fi
  local br; br=$(git_repo rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)
  git_repo pull --rebase origin "$br" 2>&1 || git_repo pull --rebase 2>&1 || warn "conflicts — check $REPO_DIR"
  ok "pull OK"
}

cmd_clone() {
  local url="${1:-}"; [[ -n "$url" ]] || { if [[ -t 0 ]]; then url=$(gum input --prompt "Git URL (private): " 2>/dev/null || true); fi; [[ -n "$url" ]] || fail "usage: clone <git-url>"; }
  command -v omarchy-git-url-check >/dev/null 2>&1 && omarchy-git-url-check "$url" || true
  [[ -d "$REPO_DIR/.git" ]] && fail "$REPO_DIR already exists — pull or remove it"
  mkdir -p "$(dirname "$REPO_DIR")"
  git clone -- "$url" "$REPO_DIR" 2>&1 || fail "clone failed (private repo without gh auth?)"
  git -C "$REPO_DIR" config core.hooksPath .githooks 2>/dev/null || true
  # A clone can succeed and check out nothing — git says "remote HEAD refers to
  # nonexistent ref" and leaves an empty directory, which happens whenever the
  # remote's default branch is not the one the commits are on. Left unsaid,
  # every restore afterwards reports "nothing to change" for every category:
  # a restore tool announcing success while restoring nothing.
  if ! git -C "$REPO_DIR" rev-parse HEAD >/dev/null 2>&1; then
    warn "the clone worked but checked out nothing — the remote's default branch has no commits."
    local branches
    branches=$(git -C "$REPO_DIR" branch -r --format='%(refname:short)' 2>/dev/null | sed 's|^origin/||' | grep -v '^HEAD' | paste -sd' ' -)
    if [[ -n "$branches" ]]; then
      warn "branches that do have them: $branches"
      warn "check one out: git -C $REPO_DIR checkout <branch>"
    else
      warn "the remote is empty — run 'create' on your first machine before cloning here"
    fi
    fail "nothing to restore from yet"
  fi
  ok "cloned into $REPO_DIR — run omarchy-replicant restore --dry-run"
}

# restore — ported bootstrap+restore-desktop, by group, with .bak.<epoch> (install_file())
cmd_restore() {
  local DRY=1 ALL_GROUPS=0 YES=0 ONLY=""
  while (( $# )); do case "$1" in
    --apply) DRY=0; shift;;
    --all) ALL_GROUPS=1; shift;;
    --dry-run) DRY=1; shift;;
    --yes|-y) YES=1; shift;;
    --only) ONLY="${2:-}"; shift 2;;
    *) shift;;
  esac; done
  [[ -d "$REPO_DIR/.git" ]] || fail "no repo"
  if (( ALL_GROUPS && !DRY && !YES )); then
    warn "restore --apply --all: this will apply every category with pending changes without asking one by one."
    read -rp "Continue and restore EVERYTHING from the repo/GitHub onto this system? .bak.<epoch> backups will be made [y/N] " resp </dev/tty 2>&1 || resp=""
    [[ $resp == [yY] ]] || fail "restore --apply --all cancelled"
  fi
  # shellcheck source=/dev/null
  source "$PLUGIN_DIR/bin/replicant-core.sh" 2>/dev/null || true

  # The plan comes from MANIFEST via plan_for_category(). It used to be a second
  # hand-written list right here, which meant adding a file to the manifest
  # backed it up but never restored it — a bug you only find on the day you need
  # the backup.
  # A theme that is not installed cannot be applied, and until now that was the
  # whole story: theme.name was restored faithfully onto a machine that had
  # never heard of "enter-the-matrix", omarchy-theme-set failed, and the single
  # most visible thing about the setup came back as nothing. Themes are git
  # clones, so they are reinstalled the way plugins are — by URL, from the
  # inventory — and this has to happen BEFORE the name is applied.
  restore_themes() {
    local dry="$1" tname torigin n=0
    while IFS=$'\t' read -r tname torigin; do
      [[ -n "$tname" ]] || continue
      n=$((n + 1))
      if (( dry )); then
        skip "dry-run: would run omarchy theme install $torigin  ($tname)" >&2
      else
        echo "  → omarchy theme install $torigin" >&2
        omarchy theme install "$torigin" >/dev/null 2>&1 \
          && ok "$tname installed" >&2 \
          || warn "$tname — omarchy theme install failed ($torigin)" >&2
      fi
    done < <(missing_themes)
    (( n == 0 )) && skip "every theme in the inventory is already installed" >&2
    return 0
  }

  restore_theme() {
    local dry="$1" want current
    # Through repo_path_for, never a hardcoded config/ path: if theme.name is
    # ever scoped to a profile its copy moves, and a restore reading the old path
    # would silently find nothing. This is the rule the restore plan already
    # follows — one function decides where a copy lives.
    want=$(head -n1 "$(repo_path_for omarchy/theme.name)" 2>/dev/null | tr -d '\r' || true)
    if [[ -z "$want" ]]; then skip "no theme recorded in the repo" >&2; return 0; fi
    current=$(omarchy-theme-current 2>/dev/null || echo "")
    # omarchy-theme-current answers "Enter The Matrix"; the file records
    # "enter-the-matrix". They differ in case AND in separator, so comparing
    # them raw — or only case-folded — made every restore claim the theme
    # needed re-applying, on a machine already wearing it.
    local wnorm cnorm
    wnorm=$(tr -cd '[:alnum:]' <<<"${want,,}")
    cnorm=$(tr -cd '[:alnum:]' <<<"${current,,}")
    if [[ -n "$wnorm" && "$wnorm" == "$cnorm" ]]; then ok "$want (already applied)" >&2; return 0; fi
    if (( dry )); then skip "dry-run: would apply theme '$want' (currently '${current:-unknown}')" >&2; return 0; fi
    if command -v omarchy-theme-set >/dev/null 2>&1; then
      omarchy-theme-set "$want" >/dev/null 2>&1 && ok "theme -> $want" >&2 || warn "could not apply theme '$want' — is it installed?" >&2
    else
      warn "omarchy-theme-set not found" >&2
    fi
  }

  # Plugins are reinstalled, not copied. `omarchy plugin add <origin>` is the
  # only thing that leaves a plugin in a state Omarchy itself will maintain.
  restore_plugins() {
    local dry="$1" pid porigin pmethod verb n=0
    while IFS=$'\t' read -r pid porigin pmethod; do
      [[ -n "$pid" ]] || continue
      n=$((n + 1))
      # Two different Omarchy commands, because they rebuild two different
      # things: a third-party plugin comes from its git remote, while an edited
      # copy of a built-in is re-cloned from the built-in it came from. Using
      # `add` on the second would fail — "omarchy.indicators" is not a URL.
      [[ "$pmethod" == "clone" ]] && verb="clone" || verb="add"
      if (( dry )); then
        skip "dry-run: would run omarchy plugin $verb $porigin  ($pid)" >&2
      else
        echo "  → omarchy plugin $verb $porigin" >&2
        if [[ "$verb" == "clone" ]]; then
          omarchy plugin clone "$porigin" >/dev/null 2>&1 \
            && ok "$pid re-cloned from $porigin (any edits you made are not in this)" >&2 \
            || warn "$pid — omarchy plugin clone failed" >&2
        else
          omarchy plugin add "$porigin" --enable --yes >/dev/null 2>&1 \
            && ok "$pid installed" >&2 || warn "$pid — omarchy plugin add failed" >&2
        fi
      fi
    done < <(missing_plugins)
    (( n == 0 )) && skip "every plugin in the inventory is already installed" >&2
    return 0
  }

  export DRY
  local cat entry src dst mode pending changed apply
  local total_changed=0
  for cat in "${CATEGORY_ORDER[@]}"; do
    [[ -n "$ONLY" && "$ONLY" != "$cat" ]] && continue
    local centry label
    centry=$(find_category "$cat") || continue
    label=$(category_field "$centry" 3)
    echo; echo "== $cat · $label" >&2

    if [[ "$cat" == "appearance" ]]; then
      # The theme rides with appearance, because that is where a user looks for
      # it — but it is installed and then applied, never copied (see
      # restore_themes / restore_theme). Order matters: applying a theme that
      # is not on the machine yet is the bug this pair exists to close.
      restore_themes "$DRY"
      restore_theme "$DRY"
    fi
    if [[ "$cat" == "plugins" ]]; then
      restore_plugins "$DRY"
    fi

    pending=()
    while IFS='|' read -r src dst mode; do
      # A trailing slash means a tree. It answers the same three questions a
      # file does — is it here, does it already match, what would change — just
      # over every file under it.
      if [[ "$src" == */ ]]; then
        [[ -d "${src%/}" ]] || continue
        if tree_same "$src" "$dst"; then
          ok "${dst/#$HOME/\~} (already matches, $(tree_count "$src") files)" >&2
        else
          pending+=("$src|$dst|$mode")
        fi
        continue
      fi
      [[ -f "$src" ]] || continue
      if [[ "$dst" != "$HOME"/* ]]; then
        # Anything outside $HOME needs root, and a backup tool silently asking
        # for a password is worse than a backup tool telling you the command.
        if [[ -f "$dst" ]] && cmp -s "$src" "$dst" 2>/dev/null; then
          ok "$dst (already matches)" >&2
        else
          warn "$dst needs root — run: sudo install -m $mode $src $dst" >&2
        fi
        continue
      fi
      if [[ -f "$dst" ]] && cmp -s "$src" "$dst" 2>/dev/null; then
        ok "${dst/#$HOME/\~} (already matches)" >&2
      else
        pending+=("$src|$dst|$mode")
      fi
    done < <(plan_for_category "$cat")

    if (( ${#pending[@]} == 0 )); then skip "nothing to change" >&2; continue; fi
    for e in "${pending[@]}"; do
      IFS='|' read -r src dst mode <<<"$e"
      echo "  ── ${dst/#$HOME/\~}" >&2
      if [[ "$src" == */ ]]; then
        tree_diff_summary "$src" "$dst" | sed 's/^/      /' >&2
      elif [[ -f $dst ]]; then
        diff -u --label system --label repo "$dst" "$src" 2>/dev/null | sed -n '3,40p' | sed 's/^/      /' >&2 || true
      else
        echo "      (doesn't exist: would be created)" >&2
      fi
    done
    if (( DRY )); then skip "dry-run: ${#pending[@]} file(s) untouched. Repeat with --apply" >&2; continue; fi
    # --yes means yes here too. It used to be honoured only through --all, so
    # `restore --apply --only hyprland --yes` still stopped to ask — and with no
    # terminal to ask on it died on /dev/tty and silently skipped the category,
    # which is a restore reporting success having restored nothing. The panel
    # worked around it by passing --all together with --only, which reads like
    # a contradiction because it was one.
    if (( ! ALL_GROUPS && ! YES )); then
      if [[ ! -r /dev/tty ]]; then
        warn "$cat needs a confirmation and there is no terminal to ask on — pass --yes" >&2
        skip "$cat skipped" >&2; continue
      fi
      read -rp "  apply $cat? [y/N] " resp </dev/tty 2>&1 || resp=""
      [[ $resp == [yY] ]] || { skip "$cat skipped" >&2; continue; }
    fi
    changed=0
    for e in "${pending[@]}"; do
      IFS='|' read -r src dst mode <<<"$e"
      if [[ "$src" == */ ]]; then install_tree "$src" "$dst" "$mode" 2>&1
      else install_file "$src" "$dst" "$mode" 2>&1; fi
      changed=$((changed + 1))
    done
    total_changed=$((total_changed + changed))
    # Make it take effect. This is the difference between a backup tool and a
    # restore tool: Hyprland does not re-read its Lua on its own, and a restored
    # terminal config is invisible until the terminal is told about it.
    apply=$(apply_for_category "$cat")
    if (( changed > 0 )) && [[ -n "$apply" ]]; then
      echo "  → $apply" >&2
      bash -c "$apply" >/dev/null 2>&1 || warn "'$apply' failed — you may need to run it yourself" >&2
      if [[ "$apply" == "hyprctl reload" ]]; then
        local errs; errs=$(hyprctl configerrors 2>/dev/null | grep -v '^no errors' || true)
        [[ -n "$errs" ]] && warn "Hyprland reported config errors after the reload:" >&2 && echo "$errs" >&2
      fi
    fi
  done
  echo
  if (( DRY )); then
    echo "Dry-run — nothing was written. To apply: omarchy-replicant restore --apply" >&2
  else
    ok "restore complete — $total_changed file(s) written, previous versions kept as .bak.<epoch>" >&2
  fi
}

cmd_reset_all() {
  local DRY=1 YES=0
  while (( $# )); do case "$1" in
    --apply) DRY=0; shift;;
    --dry-run) DRY=1; shift;;
    --yes|-y) YES=1; shift;;
    -h|--help) echo "reset-all: restores ALL configs with a known Omarchy default back to factory (omarchy refresh), with .bak.<epoch> backups. Dry-run by default."; return 0;;
    *) fail "unknown option: $1";;
  esac; done
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  local -a candidates=() rels=()
  local entry src rel crel
  for entry in "${TRACKED[@]}"; do
    src="${entry%%:*}"; rel="${entry##*:}"
    # Same reason as cmd_reset: refresh restores a file, and cmp on a directory
    # would decide whether it is "still the default" by failing.
    is_dir_entry "$rel" && continue
    [[ -f "$src" ]] || continue
    # exactly the scope of cmd_reset: a default exists to go back to, and the
    # file lives where `omarchy refresh config` can reach it
    default_for_src "$src" >/dev/null || continue
    is_default_file "$src" && continue
    crel=$(config_rel_for_src "$src") || continue
    candidates+=("$rel"); rels+=("$crel")
  done
  if (( ${#candidates[@]} == 0 )); then ok "reset-all: nothing to reset (everything is already default, or has no known default)"; return 0; fi
  echo "── reset-all: ${#candidates[@]} non-default file(s) with a known Omarchy default ──" >&2
  local rel
  for rel in "${candidates[@]}"; do echo "  · $rel" >&2; done
  if (( DRY )); then echo >&2; echo "Dry-run — nothing touched. Repeat with --apply" >&2; return 0; fi
  if (( ! YES )); then
    read -rp "Restore ${#candidates[@]} file(s) to Omarchy defaults? .bak.<epoch> backups will be made [y/N] " resp </dev/tty 2>&1 || resp=""
    [[ $resp == [yY] ]] || { warn "reset-all cancelled"; return 0; }
  fi
  local failures=0 i
  for i in "${!rels[@]}"; do
    omarchy refresh config "${rels[$i]}" 2>&1 && ok "reset ${candidates[$i]}" || { warn "failed: ${candidates[$i]}"; failures=$((failures+1)); }
  done
  if (( failures > 0 )); then warn "reset-all: $failures failure(s) — see above"; else ok "reset-all complete — check .bak.<epoch>"; fi
}

# get/set — curated per-field settings (SETTINGS registry in replicant-core.sh),
# distinct from edit/diff/reset which operate on whole tracked files
cmd_get() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "usage: get <setting-id>"
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  get_setting_value "$id" || fail "unknown or unreadable setting: $id"
}

cmd_set() {
  local id="${1:-}" value="${2:-}"
  [[ -n "$id" && -n "$value" ]] || fail "usage: set <setting-id> <value>"
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  set_setting_value "$id" "$value" || fail "could not set $id"
  # this is a real decision (a value you chose), so it gets its own commit —
  # same "one commit per decision, with the why" rule as a manual edit
  cmd_savegame -m "config: $id = $value"
}

# save-file — commit and push exactly one tracked file. The panel's per-file
# Save: after editing one config you rarely want the "everything at once"
# savegame, and you always want the commit message to say which file it was.
cmd_save_file() {
  local id="${1:-}" msg=""
  shift || true
  while (( $# )); do case "$1" in -m|--message) msg="${2:-}"; shift 2;; *) shift;; esac; done
  [[ -n "$id" ]] || fail "usage: save-file <id> [-m \"why\"]"
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  local src; src=$(resolve_manifest_src "$id") || fail "unknown id: $id"
  [[ -f "$src" ]] || fail "$src does not exist on this machine"
  local dst="$CONFIG_DIR/$id"
  case "$id" in ssh/*|env/*) dst="$SECRETS_DIR/$id" ;; esac
  mkdir -p "$(dirname "$dst")"
  if [[ "$dst" == "$SECRETS_DIR"/* ]]; then install -m 600 "$src" "$dst"; else cp -f "$src" "$dst"; fi
  local repo_rel="${dst#$REPO_DIR/}"
  if git_repo diff --quiet -- "$repo_rel" 2>/dev/null && ! git_repo status --porcelain -- "$repo_rel" 2>/dev/null | grep -q .; then
    ok "$id is already saved — nothing to commit"; return 0
  fi
  git_repo add -- "$repo_rel"
  git_repo commit -q -m "${msg:-config: update $id}" || fail "commit failed"
  if git_repo rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then
    git_repo push -q origin HEAD 2>&1 && ok "saved and pushed: $id" || warn "committed, but the push failed — try Save to GitHub"
  else
    ok "committed: $id (no remote yet — run 'omarchy-replicant create --push')"
  fi
}

cmd_log() {
  local n=8 json=0
  while (( $# )); do case "$1" in
    -n) n="${2:-8}"; shift 2;;
    --json) json=1; shift;;
    *) shift;;
  esac; done
  ensure_core
  if (( json )); then bash "$CORE" log "$n"; else
    [[ -d "$REPO_DIR/.git" ]] || fail "no repo yet"
    git_repo log -n "$n" --date=format:'%d %b %H:%M' --pretty=format:'%C(dim)%ad%C(reset)  %s'
    echo
  fi
}

cmd_settings() {
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  if [[ "${1:-}" == "--json" ]]; then build_settings_json; return 0; fi
  # Values are printed the way the panel shows them — "10 min", not "600" —
  # because a list you read should not need arithmetic. `get` still answers in
  # the stored unit, which is what scripts want.
  local order; order=$(printf '%s\n' "${SETTING_GROUPS[@]}" | cut -d'|' -f1 | jq -Rsc 'split("\n") | map(select(length > 0))')
  build_settings_json | jq -r --argjson order "$order" '
    def pad($n): . + ("                                  "[0:($n - length)] // "");
    def bold: "\u001b[1m" + . + "\u001b[0m";
    group_by(.group) | sort_by(. as $g | ($order | index($g[0].group)) // 99) | .[] |
    (.[0].group | bold),
    (.[] | "  " + (.id | pad(26)) + " " + (.label | pad(30)) + " "
         + (if .available then .value_text + (if .implicit then "  (inherited)" else "" end)
            else "— not on this machine" end)
         + (if .can_revert_default then "   [omarchy: " + .default_text + "]" else "" end)),
    ""'
}

# Both the scope list and the profile map are part of the repo's shape, so a
# change to either is committed like any other decision — otherwise the second
# machine never learns about it, which is the whole point of keeping them here.
commit_repo_shape() {
  local msg="$1"; shift
  [[ -d "$REPO_DIR/.git" ]] || return 0
  git_repo add -- "$@" >/dev/null 2>&1 || true
  if ! git_repo diff --cached --quiet -- "$@" 2>/dev/null; then
    git_repo commit -q -m "$msg" -- "$@" >/dev/null 2>&1 || true
    git_repo push -q 2>/dev/null || warn "committed locally; push failed (offline?)"
  fi
}

cmd_sync() {
  local id="${1:-}" want="${2:-}"
  [[ -n "$id" && -n "$want" ]] || fail "usage: omarchy-replicant sync <id> on|off"
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  core_sync "$id" "$want" || exit 1
  commit_repo_shape "sync: turn $id $want" .replicant-sync
}

# cmd_scope <id> <shared|profile|off> — the three-state version of `sync`, and
# what the control in every Configs row actually calls.
cmd_scope() {
  local id="${1:-}" want="${2:-}"
  [[ -n "$id" && -n "$want" ]] || fail "usage: omarchy-replicant scope <id> shared|profile|off"
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  core_scope "$id" "$want" || exit 1
  # Stage the two paths THIS file can occupy, never the whole of config/ and
  # profiles/. Staging the directories would sweep every unrelated dotfile that
  # happened to be pending into a commit whose message says "scope:", which is
  # exactly the thing the data repo's one-commit-per-decision convention exists
  # to prevent. A file is only ever at one of these two paths, and git records
  # the move between them as a rename.
  commit_repo_shape "scope: $id is now $want" \
    .replicant-sync \
    "config/$id" \
    "profiles/$(current_profile)/config/$id"
}

# cmd_profile [name] — which profile this machine belongs to. With no argument
# it prints the current one and every profile the repo knows about.
# ─── track / untrack / suggest — the user's own list ────────────────────────
# Adding a file has to be one step, or the list stays whatever the plugin
# shipped with. These three are that step, from a terminal; the panel drives
# the same core functions.
cmd_track() {
  [[ $# -gt 0 ]] || fail "usage: omarchy-replicant track <path> [name-in-repo] [--secret]"
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  local before; before=$(cat "$USER_TRACK_FILE" 2>/dev/null || true)
  core_track "$@" || exit 1
  [[ "$(cat "$USER_TRACK_FILE" 2>/dev/null || true)" == "$before" ]] && return 0
  # Only the list itself. The copy of the file arrives with the next save, in a
  # commit about the file — this one is about the decision.
  commit_repo_shape "track: $1" .replicant-track
  info "saved with the next 'omarchy-replicant savegame'"
}

cmd_untrack() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "usage: omarchy-replicant untrack <id>"
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  core_untrack "$id" || exit 1
  commit_repo_shape "untrack: $id" \
    .replicant-track \
    "config/$id" \
    "profiles/$(current_profile)/config/$id" \
    "secrets/$id"
}

cmd_suggest() {
  local as_json=0
  while (( $# )); do case "$1" in --json) as_json=1; shift;; *) shift;; esac; done
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  if (( as_json )); then core_suggest --json; return 0; fi
  local path rel reason kind flag n=0
  while IFS=$'\t' read -r path rel reason kind; do
    [[ -n "$path" ]] || continue
    n=$((n + 1))
    flag=""; [[ "$kind" == secret ]] && flag=" --secret"
    printf '  \033[36m%s\033[0m\n      %s · track it with: omarchy-replicant track %s%s\n' \
      "${path/#$HOME/\~}" "$reason" "${path/#$HOME/\~}" "$flag"
  done < <(core_suggest)
  if (( n == 0 )); then
    ok "nothing to suggest — everything worth tracking here already is"
  else
    echo
    info "$n file(s) not tracked yet. Nothing is added until you say so."
  fi
}

cmd_profile() {
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  local want="${1:-}"
  if [[ -z "$want" || "$want" == "list" ]]; then
    local cur; cur=$(current_profile)
    printf 'This machine (%s) is in the "%s" profile.\n\n' "$MACHINE" "$cur"
    printf 'Profiles in this repo:\n'
    local pr n
    while IFS= read -r pr; do
      [[ -n "$pr" ]] || continue
      # `find` on a profile directory that does not exist yet exits non-zero,
      # and under `set -o pipefail` that fails the whole assignment and, with
      # `set -e`, this function — the same trap as `grep -q` in a pipeline.
      n=$(find "$REPO_DIR/profiles/$pr/config" -type f 2>/dev/null | wc -l || true)
      if [[ "$pr" == "$cur" ]]; then printf '  * %-14s %s file(s)   <- this machine\n' "$pr" "$n"
      else printf '    %-14s %s file(s)\n' "$pr" "$n"; fi
    done < <(list_profiles)
    printf '\nMachines:\n'
    read_profile_map | sed 's/^/    /'
    return 0
  fi
  core_profile_set "$want" || exit 1
  commit_repo_shape "profile: $MACHINE is now '$want'" .replicant-profiles
  echo "Files scoped to a profile will now be saved and restored from profiles/$want/." >&2
}

# cmd_revert <setting-id> [--to default|repo] — put ONE setting back without
# touching the rest of the file it lives in. `reset` and `restore` are the
# whole-file hammers; this is the everyday one, and it is what the two small
# arrows next to every control in the panel call.
cmd_revert() {
  local id="${1:-}" to="default"
  shift || true
  while (( $# )); do case "$1" in --to) to="${2:-default}"; shift 2;; default|repo) to="$1"; shift;; *) shift;; esac; done
  [[ -n "$id" ]] || fail "usage: omarchy-replicant revert <setting-id> [--to default|repo]"
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  core_revert "$id" "$to" || exit 1
  # Same as `set`: a value that changed on this machine is worth a commit.
  if [[ -d "$REPO_DIR/.git" ]]; then
    bash "$CORE" backup >/dev/null 2>&1 || true
    git_repo add -A config/ >/dev/null 2>&1 || true
    if ! git_repo diff --cached --quiet 2>/dev/null; then
      git_repo commit -q -m "revert: $id -> $to" >/dev/null 2>&1 || true
      git_repo push -q 2>/dev/null || warn "committed locally; push failed (offline?)"
    fi
  fi
}

# cmd_restore_file <id> — bring one tracked file back from the repo, backed up
# first. `reset <id>` is its twin, going to Omarchy's default instead.
cmd_restore_file() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "usage: omarchy-replicant restore-file <id>"
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  core_restore_file "$id" || exit 1
}

# cmd_shortcuts — what you changed about the keyboard, and what is actually
# bound right now. Omarchy's model is defaults + your overrides, so only the
# overrides are backed up; a snapshot of all 227 active bindings would be stale
# the next time Omarchy updates.
cmd_shortcuts() {
  ensure_core
  if [[ "${1:-}" == "--json" ]]; then bash "$CORE" shortcuts; return 0; fi
  local json; json=$(bash "$CORE" shortcuts)
  printf '\033[1mYour own bindings\033[0m  (%s)\n' "$(jq -r '.file' <<<"$json")"
  local n; n=$(jq -r '.own_count' <<<"$json")
  if [[ "$n" == "0" ]]; then
    echo "  none — you are running Omarchy's defaults unchanged"
  else
    jq -r '.own[] | "  \(.key)\t\(if .kind == "unbind" then "(unbound)" else (if .description == "" then .command else .description end) end)"' <<<"$json" | expand -t 34
  fi
  printf '\n\033[1mActive right now\033[0m  (%s bindings, defaults included)\n' "$(jq -r '.active_count' <<<"$json")"
  jq -r '.active[] | "  \(.key)\t\(.description)"' <<<"$json" | expand -t 34
}

cmd_doctor() {
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  local problems=0
  chk_ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
  chk_warn() { printf '  \033[33m!\033[0m %s\n' "$1"; problems=$((problems+1)); }
  chk_bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; problems=$((problems+1)); }

  echo "Tools"
  for c in git jq gh; do
    command -v "$c" >/dev/null 2>&1 && chk_ok "$c installed" || chk_bad "$c missing — omarchy pkg add ${c/gh/github-cli}"
  done

  echo "Plugins"
  # The inventory is what rebuilds this machine's shell elsewhere, and a plugin
  # with no git origin cannot be rebuilt by anything. shell.json still lists it
  # in the bar layout, so the other machine would come back with a hole where
  # that widget was — worth saying here rather than discovering it there.
  local lo n_lo
  lo=$(local_only_plugins 2>/dev/null || true)
  n_lo=$(printf '%s' "$lo" | grep -c . || true)
  # An origin that is a filesystem path is a real answer here but may well not
  # exist on the machine doing the restoring, so it is called out separately
  # rather than counted as fine.
  local inv_path n_pathy
  inv_path="$STATE_DIR/omarchy-plugins.txt"
  n_pathy=$(awk -F'\t' '!/^#/ && NF>=3 && $3 ~ /^\// {n++} END{print n+0}' "$inv_path" 2>/dev/null || echo 0)
  (( n_pathy > 0 )) && chk_warn "$n_pathy plugin origin(s) are local paths — they may not exist on your other machine"
  if (( n_lo == 0 )); then
    chk_ok "every installed plugin can be reinstalled from its origin"
  else
    chk_warn "$n_lo plugin(s) exist only on this machine and cannot be reinstalled:"
    printf '%s\n' "$lo" | sed 's/^/      /' >&2
    printf '      push them to a git remote, or they are lost with this machine\n' >&2
  fi

  # Two machines, one repo, upgraded on different days. Until every machine runs
  # 0.7.0 or newer, the older one still prunes what this one tracks — it has no
  # guard to check, because the guard did not exist when it shipped.
  local seen_ver run_ver
  seen_ver=$(repo_written_by 2>/dev/null || true)
  run_ver=$(running_version 2>/dev/null || echo "?")
  if [[ -n "$seen_ver" ]] && version_lt "$run_ver" "$seen_ver"; then
    chk_warn "this repo was last written by Replicant $seen_ver and this machine has $run_ver"
    printf '    saves from here will not prune, so nothing is lost — but upgrade to see everything\n' >&2
  else
    chk_ok "this machine ($run_ver) is not behind the repo${seen_ver:+ ($seen_ver)}"
  fi

  echo "Themes"
  # The same question, for the thing a person actually looks at. A theme is a
  # git clone, so the inventory records its URL and `omarchy theme install`
  # rebuilds it — but a theme written by hand has no URL, and nothing puts it
  # back unless its directory is in the tracked list.
  local lt n_lt n_inv
  lt=$(local_only_themes 2>/dev/null || true)
  n_lt=$(printf '%s' "$lt" | grep -c . || true)
  n_inv=$(awk -F'\t' '!/^#/ && NF>=2 && $2 != "-" {n++} END{print n+0}' "$STATE_DIR/omarchy-themes.txt" 2>/dev/null || echo 0)
  chk_ok "$n_inv user theme(s) recorded with an origin — reinstalled with 'omarchy theme install'"
  if (( n_lt > 0 )); then
    chk_warn "$n_lt theme(s) have no origin and are not tracked either:"
    printf '%s\n' "$lt" | sed 's/^/      /' >&2
    printf '      track the directory to back one up: omarchy-replicant track ~/.config/omarchy/themes/<name>\n' >&2
  fi

  echo "GitHub"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    chk_ok "logged in as $(gh api user --jq .login 2>/dev/null || echo '?')"
  else
    chk_warn "not logged in — run: omarchy-replicant login"
  fi

  echo "Repo"
  if [[ -d "$REPO_DIR/.git" ]]; then
    chk_ok "local repo at $REPO_DIR"
    local url; url=$(git_repo remote get-url origin 2>/dev/null || echo "")
    if [[ -z "$url" ]]; then
      chk_warn "no remote — nothing is backed up off this machine"
    else
      chk_ok "remote $url"
      local slug vis
      slug=$(printf '%s' "$url" | sed -E 's#(https://github.com/|git@github.com:)##; s/\.git$//')
      vis=$(gh repo view "$slug" --json visibility --jq .visibility 2>/dev/null || echo "")
      case "$vis" in
        PRIVATE) chk_ok "remote is PRIVATE" ;;
        PUBLIC)  chk_bad "remote is PUBLIC and this repo holds secrets — gh repo edit $slug --visibility private" ;;
        *)       chk_warn "could not read the remote's visibility (offline, or no access)" ;;
      esac
    fi
    [[ "$(git_repo config core.hooksPath 2>/dev/null)" == ".githooks" ]] \
      && chk_ok "pre-commit secret scan enabled" \
      || chk_warn "secret-scan hook not enabled — run: omarchy-replicant savegame"
    local perm; perm=$(stat -c '%a' "$SECRETS_DIR" 2>/dev/null || echo "")
    [[ -z "$perm" ]] && chk_warn "no secrets/ directory yet" || {
      [[ "$perm" == "700" ]] && chk_ok "secrets/ is 700" || chk_bad "secrets/ is $perm, expected 700 — chmod 700 $SECRETS_DIR"
    }
  else
    chk_warn "no local repo yet — run: omarchy-replicant create --push"
  fi

  echo "Command line"
  if [[ -L "$LINK_PATH" && "$(readlink -f "$LINK_PATH" 2>/dev/null)" == "$(readlink -f "$SELF_BIN")" ]]; then
    chk_ok "omarchy-replicant is on your PATH ($LINK_PATH)"
  else
    printf '  \033[33m·\033[0m not on your PATH — the panel does not need it; run '"'"'omarchy-replicant link'"'"' to use it in a terminal\n'
  fi

  echo "Tracked files"
  local entry src missing=0 total=0
  for entry in "${TRACKED[@]}"; do
    src="${entry%%:*}"; total=$((total+1))
    # -e and the trailing slash stripped: a tracked directory is present too,
    # and -f reported every one of them as missing.
    [[ -e "${src%/}" ]] || missing=$((missing+1))
  done
  chk_ok "$((total - missing)) of $total tracked files present on this machine"
  (( missing > 0 )) && printf '    (%d not on this machine — normal on a fresh install)\n' "$missing"
  local n_user n_sugg
  n_user=$(( ${#USER_MANIFEST[@]} + ${#USER_SECRETS[@]} ))
  chk_ok "$n_user of them are yours, in .replicant-track — the rest ship with the plugin"
  n_sugg=$(core_suggest 2>/dev/null | grep -c . || true)
  (( n_sugg > 0 )) && chk_warn "$n_sugg more file(s) here are not tracked — see 'omarchy-replicant suggest'"

  echo "Settings"
  local unavailable=0 implicit=0 sid fb
  for entry in "${SETTINGS[@]}"; do
    sid=$(setting_field "$entry" 1); fb=$(setting_field "$entry" 13)
    get_setting_value "$sid" >/dev/null 2>&1 && continue
    if [[ -n "$fb" ]]; then implicit=$((implicit+1)); else unavailable=$((unavailable+1)); fi
  done
  chk_ok "$(( ${#SETTINGS[@]} - unavailable )) of ${#SETTINGS[@]} settings editable"
  (( implicit > 0 )) && printf '    (%d still at the shell'"'"'s built-in default; changing one writes the key)\n' "$implicit"
  (( unavailable > 0 )) && printf '    (%d absent from this machine'"'"'s configs — greyed out in the panel)\n' "$unavailable"
  true

  echo
  if (( problems == 0 )); then ok "No problems found."; else warn "$problems thing(s) to look at above."; fi
}

# ── PATH convenience, opt-in and reversible ─────────────────────────────────
# The panel never needs this: it calls the CLI by absolute path, resolved from
# its own location. `omarchy plugin add` runs no install hook, so a plugin that
# wanted to be on PATH would have to write outside its own directory behind the
# user's back — and leave a dangling symlink when the plugin is removed. So
# it's a command instead: explicit, and `unlink` puts it back exactly.
LINK_PATH="$HOME/.local/bin/omarchy-replicant"
SELF_BIN="$PLUGIN_DIR/bin/omarchy-replicant"

cmd_link() {
  mkdir -p "$(dirname "$LINK_PATH")"
  if [[ -L "$LINK_PATH" ]]; then
    local current; current=$(readlink -f "$LINK_PATH" 2>/dev/null || echo "")
    if [[ "$current" == "$(readlink -f "$SELF_BIN")" ]]; then ok "already linked: $LINK_PATH"; return 0; fi
    warn "$LINK_PATH points at $current — replacing it"
  elif [[ -e "$LINK_PATH" ]]; then
    fail "$LINK_PATH already exists and is not a symlink — move it aside first"
  fi
  ln -sfn "$SELF_BIN" "$LINK_PATH"
  ok "linked $LINK_PATH -> $SELF_BIN"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) : ;;
    *) warn "~/.local/bin is not on your PATH — add it to use 'omarchy-replicant' by name" ;;
  esac
}

cmd_unlink() {
  if [[ -L "$LINK_PATH" ]]; then
    rm -f "$LINK_PATH"; ok "removed $LINK_PATH"
  elif [[ -e "$LINK_PATH" ]]; then
    warn "$LINK_PATH is not a symlink — leaving it alone"
  else
    ok "nothing to unlink"
  fi
}

# ── purge — leave the machine as if the plugin had never run ────────────────
# Everything this plugin creates outside its own directory, in one place, so a
# user removing it is never left guessing what is still on disk. Dry-run by
# default like every other destructive command here.
cmd_purge() {
  local DRY=1 YES=0 KEEP_REPO=1
  while (( $# )); do case "$1" in
    --apply) DRY=0; shift;;
    --dry-run) DRY=1; shift;;
    --yes|-y) YES=1; shift;;
    --repo) KEEP_REPO=0; shift;;
    -h|--help)
      echo "purge: remove everything omarchy-replicant put on this machine outside the plugin folder."
      echo "  --apply    actually delete (default is a dry run)"
      echo "  --repo     also delete the local clone of your backup repo"
      echo "             (your GitHub repo is never touched)"
      return 0;;
    *) fail "unknown option: $1";;
  esac; done

  local -a targets=()
  [[ -L "$LINK_PATH" ]] && targets+=("$LINK_PATH")
  [[ -f "$REPLICANT_HOME/.replicant.lock" ]] && targets+=("$REPLICANT_HOME/.replicant.lock")
  [[ -f "$REPLICANT_HOME/.last-fetch" ]] && targets+=("$REPLICANT_HOME/.last-fetch")
  if (( ! KEEP_REPO )); then
    [[ -d "$REPLICANT_HOME" ]] && targets+=("$REPLICANT_HOME")
  fi

  # .bak.<epoch> copies this plugin left behind next to the configs it edited
  local -a backups=()
  local entry src
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" 2>/dev/null || true
  for entry in "${TRACKED[@]}" "${TRACKED_SECRETS[@]}"; do
    # Strip the trailing slash first. install_tree backs a directory up as
    # `<dir>.bak.<epoch>` beside it, so globbing "$src".bak.* on a tracked
    # directory looked for `~/.config/nvim/.bak.*` — INSIDE the directory —
    # and found nothing. Hard rule 8 says purge must be able to name
    # everything this plugin leaves on the machine; a whole restored tree
    # sitting next to the original is not a small thing to miss.
    src="${entry%%:*}"; src="${src%/}"
    while IFS= read -r b; do [[ -n "$b" ]] && backups+=("$b"); done \
      < <(ls -1d "$src".bak.* 2>/dev/null || true)
  done

  if (( ${#targets[@]} == 0 && ${#backups[@]} == 0 )); then
    ok "nothing to purge — this machine is already clean"
    if (( KEEP_REPO )) && [[ -d "$REPLICANT_HOME" ]]; then
      info "your backup repo is still at $REPLICANT_HOME (use --repo to remove it too)"
    fi
    return 0
  fi

  echo "── would remove ──" >&2
  local t
  for t in "${targets[@]}"; do echo "  · ${t/#$HOME/\~}" >&2; done
  (( ${#backups[@]} > 0 )) && echo "  · ${#backups[@]} .bak.<epoch> backup(s) next to your configs" >&2
  if (( KEEP_REPO )) && [[ -d "$REPLICANT_HOME" ]]; then
    echo >&2; info "keeping your backup repo at $REPLICANT_HOME — pass --repo to remove that too"
  fi

  if (( DRY )); then echo >&2; skip "dry-run — nothing was touched. Repeat with --apply" >&2; return 0; fi
  if (( ! YES )); then
    read -rp "Remove the above? Your GitHub repo is not touched. [y/N] " resp </dev/tty 2>&1 || resp=""
    [[ $resp == [yY] ]] || { warn "purge cancelled"; return 0; }
  fi
  for t in "${targets[@]}"; do rm -rf -- "$t" && ok "removed ${t/#$HOME/\~}"; done
  # -rf, not -f: a restored directory's backup is a whole tree, and rm -f on a
  # directory silently does nothing — purge listed it and then left it there.
  (( ${#backups[@]} > 0 )) && { rm -rf -- "${backups[@]}"; ok "removed ${#backups[@]} backup(s)"; }
  ok "purged. Remove the plugin itself with: omarchy plugin remove $PLUGIN_ID"
}

usage() {
  cat <<USAGE
omarchy-replicant — private savegame (config+secrets+state) for Omarchy

Usage:
  omarchy-replicant init [--savegame]     Prepare the savegame repo (always private)
  omarchy-replicant login                 gh auth
  omarchy-replicant create [name] [--push]  Create a PRIVATE repo and push
  omarchy-replicant backup                Copy only (no git)
  omarchy-replicant savegame [-m "why"] [--no-push]  backup + auto-commit state + push (leaves config/secrets for 1 commit per change)
  omarchy-replicant status [--json]
  omarchy-replicant get <setting-id>      read one curated setting (e.g. idle.screensaver)
  omarchy-replicant set <setting-id> <v>  write one curated setting + auto savegame commit
  omarchy-replicant diff [id] [--against repo|default] [--terminal]
                                          plain-text diff (the panel renders it inline)
  omarchy-replicant settings [--json]     list every editable setting and its value
  omarchy-replicant revert <id> [--to default|repo]   put ONE setting back
  omarchy-replicant scope <id> <scope>    shared | profile | off, per file
  omarchy-replicant sync <id> on|off      the older two-state form of scope
  omarchy-replicant suggest [--json]      config on this machine that is not tracked yet
  omarchy-replicant track <path> [name] [--secret]   add one file or directory to YOUR list
  omarchy-replicant untrack <id>          drop one of your own entries (and its copy)
  omarchy-replicant profile [name]        which profile this machine is in
  omarchy-replicant shortcuts [--json]    your keybinding overrides, and what is bound now
  omarchy-replicant edit <id>             open id in your editor (e.g. hypr/input.lua)
  omarchy-replicant path <id>             print the real path an id refers to
  omarchy-replicant save-file <id> [-m]   commit + push just that one file
  omarchy-replicant log [-n N] [--json]   recent saves
  omarchy-replicant doctor                check auth, remote privacy, hooks, permissions
  omarchy-replicant link | unlink         add/remove omarchy-replicant on your PATH
  omarchy-replicant purge [--apply] [--repo]  remove everything this plugin left on the machine
  omarchy-replicant reset <id>            restore the default via omarchy refresh (1 file)
  omarchy-replicant restore-file <id>     bring 1 file back from the repo (.bak.<epoch> kept)
  omarchy-replicant reset-all [--dry-run|--apply] [--yes]   Restore EVERYTHING with a known Omarchy default back to factory
  omarchy-replicant push [msg]             Direct push (not the savegame flow)
  omarchy-replicant pull
  omarchy-replicant clone <url>           Clone the private repo
  omarchy-replicant restore [--dry-run|--apply] [--all]  Bring EVERYTHING down from the repo/GitHub, by group, with .bak.<epoch>

Flow:
  omarchy-replicant init && omarchy-replicant create --push   # first machine (private)
  omarchy-replicant savegame                   # day to day
  # new machine:
  omarchy-replicant clone https://github.com/<user>/omarchy-replicant
  omarchy-replicant restore --apply

Restore everything:
  omarchy-replicant reset-all --apply          # everything -> Omarchy defaults (factory)
  omarchy-replicant restore --apply --all      # everything -> what's saved on GitHub
USAGE
}

main() {
  local cmd="${1:-}"; [[ -z "$cmd" ]] && { usage; exit 0; }
  # Anything that writes to the repo takes the lock first; read-only commands
  # (status/get/diff/edit) stay lock-free so the panel's polling never blocks.
  case "$cmd" in
    init|create|backup|savegame|set|save-file|reset|reset-all|push|pull|clone|restore|sync|scope|track|untrack|profile|revert|restore-file) acquire_repo_lock ;;
  esac
  case "$cmd" in
    -h|--help|help) usage; exit 0;;
    init) shift; cmd_init "$@";;
    login) shift; cmd_login "$@";;
    create) shift; cmd_create "$@";;
    backup) shift; cmd_backup "$@";;
    savegame) shift; cmd_savegame "$@";;
    status) shift; cmd_status "$@";;
    get) shift; cmd_get "$@";;
    set) shift; cmd_set "$@";;
    diff) shift;
      if [[ $# -gt 0 ]]; then cmd_open_diff "$@"; else cmd_diff "$@"; fi
      ;;
    edit) shift; cmd_edit "$@";;
    path) shift; cmd_path "$@";;
    save-file) shift; cmd_save_file "$@";;
    log) shift; cmd_log "$@";;
    settings) shift; cmd_settings "$@";;
    doctor) shift; cmd_doctor "$@";;
    sync) shift; cmd_sync "$@";;
    scope) shift; cmd_scope "$@";;
    track) shift; cmd_track "$@";;
    untrack) shift; cmd_untrack "$@";;
    suggest) shift; cmd_suggest "$@";;
    profile) shift; cmd_profile "$@";;
    revert) shift; cmd_revert "$@";;
    restore-file) shift; cmd_restore_file "$@";;
    shortcuts) shift; cmd_shortcuts "$@";;
    link) shift; cmd_link "$@";;
    unlink) shift; cmd_unlink "$@";;
    purge) shift; cmd_purge "$@";;
    reset) shift; cmd_reset "$@";;
    reset-all) shift; cmd_reset_all "$@";;
    push) shift;
      # legacy push wrapper for the simple repo: still works but delegates to savegame-style push
      ensure_core; bash "$CORE" backup 2>&1 | tail -n 5
      git_repo add -A 2>/dev/null || true
      if git_repo diff --cached --quiet 2>/dev/null; then ok "nothing to push"; exit 0; fi
      local msg="replicant: sync $(date -Is)"; [[ $# -gt 0 ]] && msg="$*"
      git_repo commit -m "$msg" 2>&1 | tail -n 5
      git_repo push -u origin "$(git_repo rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)" 2>&1 | tail -n 10
      ;;
    pull) shift; cmd_pull "$@";;
    clone) shift; cmd_clone "$@";;
    restore) shift; cmd_restore "$@";;
    *) fail "unknown command $cmd — --help";;
  esac
}
main "$@"
