# Packages that show up in the drift but are NOT a decision you made, so
# bin/install-paquetes.sh shouldn't try to install them. One name per line.
#
# Deliberately conservative criterion: only ignore what can be justified.
# A false positive in the delta is cheap (a redundant `--needed` that does
# nothing); a false negative is a package missing on the new machine that
# you won't discover until something fails to start. When in doubt, leave it
# in the delta.

omarchy            # Omarchy itself, comes with the ISO
omarchy-keyring    # same
omarchy-settings   # same

sudo               # Arch base, set up by the installer
mkinitcpio         # same — also pulled in by limine-mkinitcpio-install
efibootmgr         # same
intel-ucode        # microcode, chosen by the installer based on the CPU
fwupd              # firmware, same

fprintd            # installed by `omarchy setup security fingerprint`,
libfprint          # which also configures pam for sudo, polkit and hyprlock.
pam-u2f            # A plain `pkg add` would install them unconfigured.
libfido2           #
